
QWidget {
    background-color: white;
    font-family: Arial;
    font-size: 14px;
}

QPushButton {
    background-color: darkblue;
    color: white;
    padding: 10px;
    border-radius: 5px;
}

QPushButton:hover {
    background-color: steelblue;
}

QTableWidget {
    background-color: white;
    alternate-background-color: aliceblue;
    gridline-color: lightgray;
}

QSpinBox {
    background-color: white;
    padding: 6px;
    border: 1px solid gray;
    border-radius: 4px;
}

QLabel {
    color: darkslategray;
}
